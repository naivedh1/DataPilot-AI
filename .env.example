# ===========================================================================
# DataPilot AI — environment template
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# .env is git-ignored. Never commit real credentials.
# Every variable here is parsed and validated by backend/app/core/config.py.
# ===========================================================================

# --- Application ----------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (Google Gemini) --------------------------------------------------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Verified against the live API. Model names are retired over time: if you
# see a 404 naming the model, set this to one the API currently offers.
# Note the free tier allows only ~20 requests per day per model.
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.0                    # deterministic-leaning: this is SQL, not prose

# --- Database -------------------------------------------------------------
# The application connects with a READ-ONLY role. Admin credentials are used
# only by the one-off seeding/migration scripts, never by the running API.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datapilot

# Read-only role — this is what the API and all agent-generated SQL run as.
# It is the last line of defence behind the SQL validator.
POSTGRES_READONLY_USER=datapilot_readonly
POSTGRES_READONLY_PASSWORD=change-me-readonly

# Privileged role — used by scripts/generate_dataset.py and DDL only.
POSTGRES_ADMIN_USER=datapilot_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# Cluster superuser. Used exactly once, by the bootstrap script, to create the
# two roles above and the database. The running application never uses it.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# --- Query execution safeguards -------------------------------------------
SQL_STATEMENT_TIMEOUT_MS=10000   # server-side statement_timeout for every query
SQL_MAX_RESULT_ROWS=5000         # hard cap on rows returned to the client
SQL_MAX_RETRIES=2                # SQL repair attempts before giving up

# --- Agent orchestration --------------------------------------------------
AGENT_MAX_STEPS=25               # circuit breaker against runaway graph loops
CONVERSATION_MAX_TURNS=10        # how much prior context the planner may see

# --- Frontend / CORS ------------------------------------------------------
# Comma-separated list of exact origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend build-time (Vite only exposes VITE_* to the browser) ---------
VITE_API_BASE_URL=http://localhost:8000
